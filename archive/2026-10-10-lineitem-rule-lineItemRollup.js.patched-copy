/* shared/lineItemRollup.js  (2026-10-09; rule revised 2026-10-10)
   ONE place that turns budget line items into campaign / activity figures, used by Campaign Planning AND Strategy.

   THE RULE (Stef, 2026-10-10: "keep both levels, one rule" + "keep the campaign Budget as an envelope"):
     ACTIVITY   For each of Planned / Committed / Actual: if the activity has at least one budget line with a value for that stage, the
                figure is the SUM of those lines (read-only, calculated). Otherwise the activity's own typed box is used (quick mode).
                Planned = sum of Planned amounts; Committed = sum of Committed amounts; Actual = sum of Actual amounts.
     CAMPAIGN   Committed / Actual / Planned = the sum of its activities' figures (each by the rule above) PLUS the campaign's own lines
                for that stage (costs that belong to the whole campaign, not one activity).
     BUDGET     The campaign's typed Budget stays the approved ENVELOPE. Line items are "allocated" against it:
                allocated = per line, Approved amount else Planned amount, summed over the campaign's own lines and its activities' lines.
                Strategy uses the envelope as the Budget; only when the typed Budget is empty/zero does it fall back to the allocated total.

   API
     stageTotals(rows)                       -> { n, planned,hasPlanned, budget,hasBudget, committed,hasCommitted, actual,hasActual }
     index(lines)                            -> { task:{ [taskId]: totals }, camp:{ [campaignId]: totals of lines ON the campaign } }
     taskFig(idx, taskId, stage, typed)      -> stage 'planned'|'committed'|'actual': line total if the task has one, else typed
     taskHasLines(idx, taskId, stage)        -> boolean (does a line supply this figure?)
     campaignFigs(idx, campId, taskRows)     -> { planned, committed, actual, allocated, hasAllocated, hasPlanned, hasCommitted, hasActual, n }
                                                taskRows: [{ id, planned, committed, actual }] typed values of the campaign's activities
     build(lines, tasks)                     -> { [campaignId]: { n, budget(=allocated), hasBudget, committed, hasCommitted, actual, hasActual } }
                                                lines: budget_line_items rows; tasks: rows { id, campaign_id, planned_cost, committed_cost, actual_cost }
                                                has* = at least one LINE supplies that stage for the campaign (otherwise callers keep their own figure)
     figure(camp, 'budget'|'committed'|'actual') -> number, or null when this figure should not come from lines
   ROLLBACK: restore archive/2026-10-10-pre-lineitem-rule-lineItemRollup.js (the 9 Oct "lines replace everything" rule). */
(function(){
  'use strict';
  var G = (typeof window !== 'undefined') ? window : globalThis;
  function isNum(v){ return v !== null && v !== undefined && v !== '' && isFinite(Number(v)); }
  function num(v){ return isNum(v) ? Number(v) : 0; }
  function blank(){ return { n:0, planned:0, hasPlanned:false, budget:0, hasBudget:false, committed:0, hasCommitted:false, actual:0, hasActual:false }; }
  function add(r, li){
    r.n++;
    if(isNum(li.planned_amount)){ r.planned += Number(li.planned_amount); r.hasPlanned = true; }
    var b = isNum(li.approved_amount) ? Number(li.approved_amount) : (isNum(li.planned_amount) ? Number(li.planned_amount) : null);
    if(b !== null){ r.budget += b; r.hasBudget = true; }
    if(isNum(li.committed_amount)){ r.committed += Number(li.committed_amount); r.hasCommitted = true; }
    if(isNum(li.actual_amount)){ r.actual += Number(li.actual_amount); r.hasActual = true; }
  }
  function stageTotals(rows){ var r = blank(); (rows || []).forEach(function(li){ if(li) add(r, li); }); return r; }
  function index(lines){
    var idx = { task:{}, camp:{} };
    (lines || []).forEach(function(li){
      if(!li || !li.parent_id) return;
      var bag = li.parent_type === 'task' ? idx.task : (li.parent_type === 'campaign' ? idx.camp : null);
      if(!bag) return;
      add(bag[li.parent_id] || (bag[li.parent_id] = blank()), li);
    });
    return idx;
  }
  var HAS = { planned:'hasPlanned', committed:'hasCommitted', actual:'hasActual' };
  function taskHasLines(idx, taskId, stage){ var t = idx && idx.task && idx.task[taskId]; return !!(t && HAS[stage] && t[HAS[stage]]); }
  function taskFig(idx, taskId, stage, typed){
    var t = idx && idx.task && idx.task[taskId];
    if(t && HAS[stage] && t[HAS[stage]]) return t[stage];
    return num(typed);
  }
  function campaignFigs(idx, campId, taskRows){
    var c = (idx && idx.camp && idx.camp[campId]) || blank();
    var out = { planned:0, committed:0, actual:0, allocated:c.budget, hasAllocated:c.hasBudget, hasPlanned:c.hasPlanned, hasCommitted:c.hasCommitted, hasActual:c.hasActual, n:c.n };
    ['planned','committed','actual'].forEach(function(st){ if(c[HAS[st]]) out[st] += c[st]; });
    (taskRows || []).forEach(function(t){
      var tl = idx && idx.task && idx.task[t.id];
      ['planned','committed','actual'].forEach(function(st){ out[st] += taskFig(idx, t.id, st, t[st]); if(tl && tl[HAS[st]]) out[HAS[st]] = true; });
      if(tl){ out.n += tl.n; if(tl.hasBudget){ out.allocated += tl.budget; out.hasAllocated = true; } }
    });
    return out;
  }
  function build(lines, tasks){
    var idx = index(lines), byCamp = {};
    (tasks || []).forEach(function(t){
      if(!t || !t.id || !t.campaign_id) return;
      (byCamp[t.campaign_id] || (byCamp[t.campaign_id] = [])).push({ id:t.id, planned:t.planned_cost, committed:t.committed_cost, actual:t.actual_cost });
    });
    var out = {};
    function one(cid){
      var f = campaignFigs(idx, cid, byCamp[cid] || []);
      if(!f.n) return;
      out[cid] = { n:f.n, budget:f.allocated, hasBudget:f.hasAllocated, committed:f.committed, hasCommitted:f.hasCommitted, actual:f.actual, hasActual:f.hasActual };
    }
    var seen = {};
    Object.keys(idx.camp).forEach(function(cid){ seen[cid] = 1; one(cid); });
    Object.keys(byCamp).forEach(function(cid){ if(!seen[cid]) one(cid); });
    return out;
  }
  function figure(camp, which){
    var li = camp && camp.li;
    if(!li) return null;
    if(which === 'budget'){ if(num(camp.budget) > 0) return null; return li.hasBudget ? li.budget : null; }
    if(which === 'committed') return li.hasCommitted ? li.committed : null;
    if(which === 'actual')    return li.hasActual    ? li.actual    : null;
    return null;
  }
  G.NorthLineItemRollup = { stageTotals:stageTotals, index:index, taskFig:taskFig, taskHasLines:taskHasLines, campaignFigs:campaignFigs, build:build, figure:figure };
})();
