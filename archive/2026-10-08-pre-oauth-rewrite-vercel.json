{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(strategy|campaigns|campaign-planning|events|asset-register|targets|scoring|process-maps|configuration|reporting|dashboard)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/strategy",
      "destination": "/Strategy.html"
    },
    {
      "source": "/campaigns",
      "destination": "/CampaignPlanning.html"
    },
    {
      "source": "/campaign-planning",
      "destination": "/CampaignPlanning.html"
    },
    {
      "source": "/events",
      "destination": "/Events.html"
    },
    {
      "source": "/asset-register",
      "destination": "/AssetRegister.html"
    },
    {
      "source": "/targets",
      "destination": "/Targets.html"
    },
    {
      "source": "/scoring",
      "destination": "/Scoring.html"
    },
    {
      "source": "/process-maps",
      "destination": "/ProcessMaps.html"
    },
    {
      "source": "/configuration",
      "destination": "/Configuration.html"
    },
    {
      "source": "/reporting",
      "destination": "/Reporting.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    }
  ]
}
