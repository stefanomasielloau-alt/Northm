path = "Norma.html"
with open(path, "r") as f:
    content = f.read()

old = (
    "Issues reported from the floating feedback button on every North page. Name, page, and timestamp\n"
    "      are captured automatically -- only the description is typed by the reporter. Hub and Seek have their own\n"
    "      separate feedback list (Hub Settings) -- not shown here yet, see the Help &amp; FAQ for why."
)
new = (
    "Issues reported from the floating feedback button on every North page. Name, page, and timestamp\n"
    "      are captured automatically -- only the description is typed by the reporter. Hub and Seek have their own\n"
    "      separate feedback list, mirrored into North on the \"Hub feedback\" page (left of this one) -- kept apart\n"
    "      since they come from a different app with its own reporters, not merged into the table below."
)

if content.count(old) != 1:
    print("NOT FOUND / not unique, count =", content.count(old))
else:
    content = content.replace(old, new, 1)
    with open(path, "w") as f:
        f.write(content)
    print("patched ok")
